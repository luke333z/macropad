  printStatus(true);

  // MACRO PAD ADC
  tft.print("Macro keypad ");
  tft.setTextColor(COL_WORK, ILI9341_BLACK);
  printDots();
  analogReadResolution(12);
  analogSetPinAttenuation(KEYPAD_ADC_PIN, ADC_11db);
  printStatus(true);

  // BOOT TIME
  uint32_t bootTime = millis() - bootStart;
  tft.println();
  tft.setTextColor(COL_INFO, ILI9341_BLACK);
  tft.print("Boot time: ");
  tft.print(bootTime);
  tft.println(" ms");


  TJpgDec.setCallback(tftOutput);
  TJpgDec.setSwapBytes(true);
  TJpgDec.setJpgScale(4); // 1=full, 2=1/2, 4=1/4
  


  delay(4500);



  // MAIN UI
  drawMainUI();
}


// ----------------- LOOP -----------------
void loop() {
  // Run encoder first so fast spins still work even if art receive blocks
  handleEncoderVolume();
  handleButtonMute();
  
  handleBleSleep();

  if(screenOff)
    return;

  
  mediaReceive();
  
  if (uiMode == UI_MAIN) {
    if (metaDirty) { /* redraw meta + icon */ }
    drawProgressBar();
  }

   // ---- UI MODE TRANSITION ----
  if (uiMode != lastUiMode) {
    if (uiMode == UI_MAIN) {
      metaDirty = true;
      progressBgDrawn = false;   // ⬅ force bar background redraw ONCE
    }
    lastUiMode = uiMode;
  }



  TouchPointPx tp = handleTouchscreen();
  if(tp.pressed){
    if(uiMode == UI_SLIDER)
    {
      uiMode = UI_MAIN;
      sliderUiDrawn = false;
      lastSliderShown = -1;
      barLastFilled = -1;

      drawMainUI();
    }

    if(uiMode == UI_MAIN)
    {
      if (hit(tp.x, tp.y, 15, 222, 55, 55)) {
        if (bleKeyboard.isConnected()) bleKeyboard.write(KEY_MEDIA_PREVIOUS_TRACK);
      }
      else if (hit(tp.x, tp.y, 80, 222, 55, 55)) {
        if (bleKeyboard.isConnected()) bleKeyboard.write(KEY_MEDIA_PLAY_PAUSE);
      }
      else if (hit(tp.x, tp.y, 175, 222, 55, 55)) {
        if (bleKeyboard.isConnected()) bleKeyboard.write(KEY_MEDIA_NEXT_TRACK);
      }
    }
    delay(500);
  }

  MQTTclient.loop();
  if (!MQTTclient.connected()) connectMQTT();



  if (metaDirty && uiMode == UI_MAIN) {
    metaDirty = false;
    artReady = false;

    if (downloadAlbumArt(gArtUrl)) {
      artReady = true;
    }





    drawCenteredText(gTitle,  TITLE_Y,  TITLE_H,  ILI9341_WHITE);
    drawCenteredText(gArtist, ARTIST_Y, ARTIST_H, ILI9341_LIGHTGREY);

    tft.fillRect(95, 242, 50, 50, ILI9341_BLACK);
    if (gPlaying)
      tft.drawBitmap(95, 242, pause_bmp, 50, 50, ILI9341_WHITE);
    else
      tft.drawBitmap(95, 242, play_bmp, 50, 50, ILI9341_WHITE);
  }
  if (artReady) {
    drawAlbumArtLocal();
    artReady = false;
  }


  drawTime();

  updateSlidersAndDetectMove();

if (uiMode == UI_SLIDER) {
  drawSliderUIAnimated(activeSlider);

  // dacă NU a mai fost mișcare → revine la menu
  if (millis() - lastSliderActivity > 2000) {
    uiMode = UI_MAIN;
    sliderUiDrawn = false;
    lastSliderShown = -1;
    barLastFilled = -1;

    drawMainUI();   // ← menu-ul reapare
  }
}



  int key = readKeypad3x3();
  if (key != -1) 
    handleKeyboardKey(key);
  
 

  static uint32_t lastSend = 0;
  uint32_t now = millis();
  if (now - lastSend >= 50) {
    lastSend = now;
