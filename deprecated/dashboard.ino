//TOUCHSCREEN
static TouchPointPx lastTouch = {false, 0, 0};
static uint32_t lastTouchMs = 0;

// Map helper (clamps)
static int16_t mapClamp(int v, int inMin, int inMax, int outMin, int outMax) {
  if (inMin == inMax) return outMin;
  if (v < inMin) v = inMin;
  if (v > inMax) v = inMax;
  long res = (long)(v - inMin) * (outMax - outMin) / (long)(inMax - inMin) + outMin;
  if (res < outMin) res = outMin;
  if (res > outMax) res = outMax;
  return (int16_t)res;
}

//hitbox helper
static bool hit(int16_t x, int16_t y, int16_t rx, int16_t ry, int16_t rw, int16_t rh) {
  return (x >= rx && x < rx + rw && y >= ry && y < ry + rh);
}


// Reads touch and returns screen pixel coords for YOUR current rotation (3)
TouchPointPx handleTouchscreen() {
  TouchPointPx out = {false, 0, 0};

  // optional: if using IRQ pin, you can check digitalRead(TS_IRQ) first
  if (!ts.touched()) {
    lastTouch.pressed = false;
    return out;
  }

  // Read raw point
  TS_Point p = ts.getPoint();   // p.x, p.y, p.z (pressure)
  // Some boards need this after reading touch if share SPI with TFT:
  // pinMode(TS_CS, OUTPUT);

  // Basic debounce / rate limit
  uint32_t now = millis();
  if (now - lastTouchMs < 15) {   // 15ms
    return lastTouch;
  }
  lastTouchMs = now;

  // Convert raw to "unrotated" screen coords (rotation 0 coordinate system)
  int16_t xr = mapClamp(p.x, TS_MINX, TS_MAXX, 0, tft.width() - 1);
  int16_t yr = mapClamp(p.y, TS_MINY, TS_MAXY, 0, tft.height() - 1);

  // Now apply rotation transform
  // Your tft.setRotation(3).
  // For Adafruit_GFX rotations:
  // 0: normal, 1: 90, 2: 180, 3: 270
  // We'll convert from rotation-0 to rotation-3 pixel space.
  int16_t x, y;
  // If your raw mapping matches a different orientation, swap xr/yr or invert one axis.
  // This transform assumes xr,yr correspond to rotation 0.
  x = 240-xr;
  y = yr;

  // Clamp
  if (x < 0) x = 0;
  if (x >= tft.width()) x = tft.width() - 1;
  if (y < 0) y = 0;
  if (y >= tft.height()) y = tft.height() - 1;

  out.pressed = true;
  out.x = x;
  out.y = y;

  // Simple smoothing (optional): average with last point to reduce jitter
  if (lastTouch.pressed) {
    out.x = (out.x + lastTouch.x) / 2;
    out.y = (out.y + lastTouch.y) / 2;
  }

  lastTouch = out;
  return out;
}

// rtc
RTC_Time readRTC() {
  RTC_Time t;

  DateTime now = rtc.now();

  t.hour   = now.hour();
  t.minute = now.minute();
  t.second = now.second();
  t.day    = now.day();
  t.month  = now.month();
  t.year   = now.year();

  return t;
}

void drawTime() {
  static int lastSecond = -1;

  RTC_Time t = readRTC();              
  if (t.second == lastSecond) return;  
  lastSecond = t.second;

  char buf[9];
  snprintf(buf, sizeof(buf), "%02d:%02d:%02d", t.hour, t.minute, t.second);

  tft.setCursor(1, 2);
  tft.setTextSize(1);
  tft.setTextColor(ILI9341_WHITE, ILI9341_BLACK);
  tft.print(buf);
}

bool syncRTCFromNTP() {
  if (WiFi.status() != WL_CONNECTED) {
    return false;
  }

  configTzTime(TZ_INFO, NTP_SERVER);

  struct tm timeinfo;
  if (!getLocalTime(&timeinfo, 10000)) {   // wait up to 10s
    return false;
  }

  DateTime now(
    timeinfo.tm_year + 1900,
    timeinfo.tm_mon + 1,
    timeinfo.tm_mday,
    timeinfo.tm_hour,
    timeinfo.tm_min,
    timeinfo.tm_sec
  );

  rtc.adjust(now);


  return true;
}

// macro pad
int readKeypad3x3() {
  static int lastKey = -1;
  static uint32_t lastChangeMs = 0;

  // --- ADC averaging ---
  uint32_t sum = 0;
  for (int i = 0; i < KEYPAD_SAMPLES; i++) {
    sum += analogRead(KEYPAD_ADC_PIN);
    delayMicroseconds(150);
  }
  int v = sum / KEYPAD_SAMPLES;

  //Serial.println(v);

  // --- no key zone ---
  int key = -1;
  if (v < 200) {
    key = -1;
  }
  else if (v > 3400) key = 2;   // 1k
  else if (v > 3000) key = 1;   // 2.2k
  else if (v > 2600) key = 0;   // 3.3k
  else if (v > 2200) key = 3;   // 4.7k
  else if (v > 2000) key = 4;   // 6.8k
  else if (v > 1700) key = 5;   // 10k
  else if (v > 900) key = 6;   // 22k
  else if (v > 400)  key = 7;   // 47k
  else if (v > 200)  key = 8;   // 65k

  // --- debounce ---
  uint32_t now = millis();
  if (key != lastKey) {
    lastChangeMs = now;
    lastKey = key;
    return -1;   // așteaptă stabilizare
  }

  if (now - lastChangeMs < KEYPAD_DEBOUNCE_MS) {
    return -1;
  }
  //Serial.print(key);
  //Serial.print("with voltage");
 // Serial.println(v);
  return key;
}

void handleKeyboardKey(int key) {
  switch (key) {
    case 0:
      publishKey(key);
      break;

    case 1:
      publishKey(key);
      break;

    case 2:
      publishKey(key);
      break;
      
    case 3:  // Ctrl + Alt + N
      bleKeyboard.press(KEY_LEFT_CTRL);
      bleKeyboard.press(KEY_LEFT_ALT);
      bleKeyboard.press('n');
      delay(10);
      bleKeyboard.releaseAll();
      break;

    case 4:  // Ctrl + Alt + G
      bleKeyboard.press(KEY_LEFT_CTRL);
      bleKeyboard.press(KEY_LEFT_ALT);
      bleKeyboard.press('g');
      delay(10);
      bleKeyboard.releaseAll();
      break;

    default:
      break;
  }
}

