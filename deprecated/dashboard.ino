#include "SPIFFS.h"

#include <HTTPClient.h>

bool downloadAlbumArt(const char* url) {
  if (!url || url[0] == 0) return false;
  if (WiFi.status() != WL_CONNECTED) return false;

  HTTPClient http;
  http.begin(url);
  int code = http.GET();

  if (code != HTTP_CODE_OK) {
    http.end();
    return false;
  }

  File f = SPIFFS.open("/cover.jpg", "w");
  if (!f) {
    http.end();
    return false;
  }

  WiFiClient* stream = http.getStreamPtr();
  uint8_t buf[512];

  while (http.connected()) {
    size_t len = stream->available();
    if (len) {
      int c = stream->readBytes(buf, min(len, sizeof(buf)));
      f.write(buf, c);
    }
    delay(1);
  }

  f.close();
  http.end();
  return true;
}

void drawAlbumArtLocal() {
  if (!SPIFFS.exists("/cover.jpg")) {
    Serial.println("No local cover");
    return;
  }

  tft.fillRect(56, 42, 128, 128, ILI9341_BLACK);
  TJpgDec.drawJpg(56, 42, "/cover.jpg");
}

