#define SLIDER_DEADBAND 6

int readADC(int pin, int idx) {
  const int N = 7;                 // număr impar
  static int lastOut[NUM_SLIDERS] = {0};
  int buf[N];

  // colectare probe
  for (int i = 0; i < N; i++) {
    buf[i] = analogRead(pin) / 4;  // 0..1023
    delayMicroseconds(80);
  }

  // sortare (N mic, OK)
  for (int i = 0; i < N - 1; i++) {
    for (int j = i + 1; j < N; j++) {
      if (buf[j] < buf[i]) {
        int t = buf[i];
        buf[i] = buf[j];
        buf[j] = t;
      }
    }
  }

  int median = buf[N / 2];

  // hysteresis (anti-jitter)
  if (abs(median - lastOut[idx]) < 6) {
    return lastOut[idx];
  }

  lastOut[idx] = median;
  return median;
}



void updateSlidersAndDetectMove() {
  static int lastStable[NUM_SLIDERS] = {0};
  static uint32_t lastMoveTime[NUM_SLIDERS] = {0};

  for (int i = 0; i < NUM_SLIDERS; i++) {

    int v = readADC(analogInputs[i], i);

    // ignoră zgomot mic
    if (abs(v - lastStable[i]) <= SLIDER_DEADBAND) {
      // slider stabil
      if (uiMode == UI_SLIDER &&
          activeSlider == i &&
          millis() - lastSliderActivity > 1500) {

        uiMode = UI_MAIN;
        sliderUiDrawn = false;
        lastSliderShown = -1;
        barLastFilled = -1;
        drawMainUI();
      }
      continue;
    }

    // MIȘCARE REALĂ
    lastStable[i] = v;
    lastMoveTime[i] = millis();

    activeSlider = i;
    uiMode = UI_SLIDER;
    lastSliderActivity = millis();
    sliderTarget = v;

    analogSliderValues[i] = v;
  }
}






void drawVerticalBarSmooth(
  int x, int y, int w, int h,
  int value, uint16_t color
) {
  value = constrain(value, 0, 1023);

  int filled = map(value, 0, 1023, 0, h);

  if (filled == barLastFilled) return;

  // 🔻 dacă scade → șterge partea DE JOS
  if (filled < barLastFilled && barLastFilled >= 0) {
    tft.fillRect(
      x + 2,
      y + h - barLastFilled,
      w - 4,
      barLastFilled - filled,
      ILI9341_BLACK
    );
  }

  // 🔺 dacă crește → desenează de jos în sus
  if (filled > barLastFilled) {
    tft.fillRect(
      x + 2,
      y + h - filled,
      w - 4,
      filled - barLastFilled,
      color
    );
  }

  barLastFilled = filled;
}




void drawSliderUIStatic(int slider) {
  tft.fillScreen(ILI9341_BLACK);

  // ICON
  tft.drawRGBBitmap(
    (tft.width() - 32) / 2,
    20,
    sliderIcons[slider],
    32,
    32
  );

  // NUME CENTRAT
  tft.setTextSize(2);
  tft.setTextColor(ILI9341_WHITE);
  int16_t x1, y1;
  uint16_t w, h;
  tft.getTextBounds(sliders[slider].name, 0, 60, &x1, &y1, &w, &h);
  tft.setCursor((tft.width() - w) / 2, 60);
  tft.print(sliders[slider].name);

  // CONTUR BAR
  tft.drawRect(180, 110, 26, 140, ILI9341_WHITE);

  barLastFilled = -1;   // ✅ reset DOAR AICI
  sliderUiDrawn = true;
}


void drawPercent(int x, int y, int value) {
  static int lastPct = -1;

  int pct = map(value, 0, 1023, 0, 100);
  pct = constrain(pct, 0, 100);

  if (pct == lastPct) return;
  lastPct = pct;
  if(pct >= 98)
    pct = 100;
  tft.fillRect(x, y, 80, 30, ILI9341_BLACK);

  tft.setTextSize(2);
  tft.setTextColor(ILI9341_WHITE);
  tft.setCursor(x, y);

  char buf[8];
  snprintf(buf, sizeof(buf), "%3d%%", pct);
  tft.print(buf);
}



void drawSliderUIAnimated(int slider) {

  if (slider != lastSliderShown) {
    sliderUiDrawn = false;
    lastSliderShown = slider;
  }

  if (!sliderUiDrawn) {
    drawSliderUIStatic(slider);
    sliderDisplay = sliderTarget;
  }

  uint32_t now = millis();
  if (now - lastAnimMs < 16) return;
  lastAnimMs = now;

  int prev = sliderDisplay;
  sliderDisplay += (sliderTarget - sliderDisplay) / 6;  // easing mai stabil

  if (abs(sliderTarget - sliderDisplay) < 4) {
    sliderDisplay = sliderTarget;
    return;
  }

  if (sliderTarget > 975) sliderTarget = 1023;



  drawVerticalBarSmooth(
    180, 110,
    26, 140,
    sliderDisplay,
    sliders[slider].color
  );

  drawPercent(70, 160, sliderDisplay);
}



// ----------------- ENCODER -----------------
void handleEncoderVolume() {
  CLK_state = digitalRead(CLK_PIN);
  if (CLK_state != prev_CLK_state && CLK_state == HIGH) {
    if (digitalRead(DT_PIN) == HIGH) {
      direction = DIRECTION_CCW;
    } else {
      direction = DIRECTION_CW;
    }

    if (direction == DIRECTION_CW)
      bleKeyboard.write(KEY_MEDIA_VOLUME_UP);
    else
      bleKeyboard.write(KEY_MEDIA_VOLUME_DOWN);
  }
  prev_CLK_state = CLK_state;

}


void handleButtonMute() {
  uint8_t btn = (uint8_t)digitalRead(ENC_SW);
  if (btn != lastBtn && (millis() - lastBtnMs) > 30) {
    lastBtnMs = millis();
    lastBtn = btn;
    if (btn == LOW && bleKeyboard.isConnected()) {
      bleKeyboard.write(KEY_MEDIA_MUTE);
    }
  }
}

