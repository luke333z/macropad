void drawProgressBar() {
  if (gDurMs == 0) return;

  const int barX = 20;
  const int barY = 190;
  const int barW = 200;
  const int barH = 9;
  const int r    = barH / 2;
  const int cy   = barY + r;

  int filled = map(gPosMs, 0, gDurMs, 0, barW);
  filled = constrain(filled, 0, barW);

  static int lastFilled = -1;
  static bool lastPlaying = true;

  // -------- BACKGROUND (draw ONCE, perfect pill) --------
  if (!progressBgDrawn) {
    // left cap
    tft.fillCircle(barX + r, cy, r, ILI9341_DARKGREY);
    // body
    tft.fillRect(barX + r, barY, barW - 2 * r, barH, ILI9341_DARKGREY);
    // right cap
    tft.fillCircle(barX + barW - r, cy, r, ILI9341_DARKGREY);

    lastFilled = -1;
    progressBgDrawn = true;
  }

  // nothing changed → nothing to redraw
  if (filled == lastFilled && gPlaying == lastPlaying) return;

  // -------- ERASE OLD FOREGROUND ONLY --------
  if (lastFilled > 0) {
    int eraseW = max(lastFilled - r, 0);
    tft.fillRect(barX + r, barY, eraseW+1, barH, ILI9341_DARKGREY);
    tft.fillCircle(barX + r, cy, r, ILI9341_DARKGREY);
    tft.fillRect(barX + barW - r, barY, barH , barH, ILI9341_BLACK);
    tft.fillCircle(barX + barW - r, cy, r, ILI9341_DARKGREY);

  }

  lastFilled = filled;
  lastPlaying = gPlaying;

  if (filled <= 0) return;

  uint16_t col = gPlaying ? ILI9341_GREEN : ILI9341_LIGHTGREY;

  // -------- FOREGROUND (same geometry as background) --------

  if (filled <= r) {
    // tiny progress → single circle only
    tft.fillCircle(barX + r, cy, filled, col);
    return;
  }

  // left cap
  tft.fillCircle(barX + r, cy, r, col);

  // body
  int bodyW = min(filled - 2 * r, barW - 2 * r);
  if (bodyW > 0) {
    tft.fillRect(barX + r, barY, bodyW, barH, col);
  }

  // right cap (only if not full)
  if (filled < barW) {
    tft.fillCircle(barX + max(filled - r,r), cy, r, col);
  } else {
    // full bar → draw right background cap in foreground color
    tft.fillCircle(barX + barW - r, cy, r, col);
  }
}

//sleep

void handleBleSleep() {
  bool bleConnected = bleKeyboard.isConnected();
  uint32_t now = millis();

  // ---- BLE CONNECTED ----
  if (bleConnected) {
    bleDisconnectedSince = 0;

    if (screenOff) {
      tft.writeCommand(ILI9341_DISPON);
      delay(20);
      drawMainUI();

      screenOff = false;
    }
    return;
  }

  // ---- BLE DISCONNECTED ----
  if (bleDisconnectedSince == 0) {
    bleDisconnectedSince = now;
    return;
  }

  if (now - bleDisconnectedSince >= BLE_SCREEN_OFF_DELAY_MS) {
    if (!screenOff) {

      tft.fillScreen(ILI9341_BLACK);
      tft.writeCommand(ILI9341_DISPOFF);

      screenOff = true;
    }
  }
}

// media transfer
void mediaUdpInit() {
  mediaUdp.begin(MEDIA_PORT);
}

bool mediaReceive() {
  // actualizează doar când ești în UI_MAIN
  if (uiMode != UI_MAIN) return false;

  int len = mediaUdp.parsePacket();
  if (!len) return false;

  int n = mediaUdp.read(mediaPacket, sizeof(mediaPacket) - 1);
  if (n <= 0) return false;
  mediaPacket[n] = 0;

  String s(mediaPacket);

  int p1 = s.indexOf('|');
  int p2 = s.indexOf('|', p1 + 1);
  int p3 = s.indexOf('|', p2 + 1);
  int p4 = s.indexOf('|', p3 + 1);
  int p5 = s.indexOf('|', p4 + 1);

  if (p1 < 0 || p2 < 0 || p3 < 0 || p4 < 0 || p5 < 0) return false;

  String title   = s.substring(0, p1);
  String artist  = s.substring(p1 + 1, p2);
  uint32_t pos   = s.substring(p2 + 1, p3).toInt();
  uint32_t dur   = s.substring(p3 + 1, p4).toInt();
  String artUrl  = s.substring(p4 + 1, p5);
  bool playing   = (s.substring(p5 + 1).toInt() == 1);

  uint32_t newPosMs = pos * 1000;
  uint32_t newDurMs = dur * 1000;

  // ---- TIMING (mereu actualizat) ----
  gPosMs = newPosMs;
  gDurMs = newDurMs;

  // ---- PLAY / PAUSE ----
  bool playChanged = (gPlaying != playing);
  gPlaying = playing;

  // ---- META CHANGE ----
  bool titleChanged  = strcmp(gTitle, title.c_str()) != 0;
  bool artistChanged = strcmp(gArtist, artist.c_str()) != 0;
  bool durChanged    = (newDurMs != lastDurMs);

  if (titleChanged) {
    strncpy(gTitle, title.c_str(), sizeof(gTitle) - 1);
  }

  if (artistChanged) {
    strncpy(gArtist, artist.c_str(), sizeof(gArtist) - 1);
  }

  if (durChanged) {
    lastDurMs = newDurMs;
    progressBgDrawn = false;   // forțează redraw bar
  }

  // ---- ALBUM ART URL ----
  static char lastArtUrl[256] = {0};
  bool artChanged = strcmp(lastArtUrl, artUrl.c_str()) != 0;

  if (artChanged) {
    strncpy(lastArtUrl, artUrl.c_str(), sizeof(lastArtUrl) - 1);
    strncpy(gArtUrl, artUrl.c_str(), sizeof(gArtUrl) - 1);
  }

  // ---- REDRAW DECISION ----
  if (titleChanged || artistChanged || durChanged || playChanged || artChanged) {
    metaDirty = true;
  }

  return true;
}



void drawCenteredText(
  const char* txt,
  int y,
  int h,
  uint16_t color
) {
  tft.fillRect(0, y, 240, h, ILI9341_BLACK);

  u8g2.setForegroundColor(color);
  u8g2.setBackgroundColor(ILI9341_BLACK);

  int16_t tw = u8g2.getUTF8Width(txt);
  int x = (240 - tw) / 2;
  if (x < 2) x = 2;

  int baseline = y + h - 2;
  u8g2.setCursor(x, baseline);
  u8g2.print(txt);
}

